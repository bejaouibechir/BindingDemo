<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BindingDemo.RelativeSelfExemple1PageDemo"
             Title="RelativeSelfExemple1PageDemo">
    <VerticalStackLayout>
        <!--Première technique de self binding-->
        <Rectangle x:Name="rectangle" Fill="Red" WidthRequest="100" 
                   HeightRequest="{Binding Path=WidthRequest, Source={x:Reference rectangle}}"/>

        <Rectangle Fill="Blue" WidthRequest="100"  
                   HeightRequest="{Binding Path=WidthRequest, Source={RelativeSource Self}}"/>

    </VerticalStackLayout>
</ContentPage>