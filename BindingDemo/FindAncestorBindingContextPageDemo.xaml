<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BindingDemo.FindAncestorBindingContextPageDemo"
             xmlns:local="clr-namespace:BindingDemo"
             Title="FindAncestorBindingContextPageDemo">
    <ContentPage.Resources>
        <Color x:Key="green">#00FF00</Color>
        <local:ViewModelBase x:Key="vmodelbase" ColorBase="{StaticResource Key=green}"/>
        <local:ViewModel x:Key="vmodel" ColorBase="Red"/>
    </ContentPage.Resources>

    <VerticalStackLayout BindingContext="{StaticResource Key=vmodelbase}">
         <VerticalStackLayout>
            <Label 
                Text="Welcome to .NET MAUI!"
                VerticalOptions="Center" 
                HorizontalOptions="Center" />
            <StackLayout BindingContext="{StaticResource Key=vmodel}">
                <Label Text="Label 1" />
                <Label Text="Label 2" BackgroundColor="{Binding Path=ColorBase, 
                    Source={RelativeSource Mode=FindAncestorBindingContext, 
                    AncestorLevel=1,AncestorType={x:Type local:ViewModelBase} }}"  />
            </StackLayout>

        </VerticalStackLayout>
    </VerticalStackLayout>
   
</ContentPage>