<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BindingDemo.AttachedPropertyPageDemo2"
             xmlns:local="clr-namespace:BindingDemo"
             Title="AttachedPropertyPageDemo2">
    <StackLayout >
        <Grid HorizontalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Label Text="Vérification de mail" Grid.ColumnSpan="2"  HorizontalOptions="Center" />
            <Label Text="Mail: "
                   Grid.Row="1"  VerticalOptions="Center" Margin="0,0,5,0"/>
            <Entry x:Name="entry1" Grid.Row="1" Grid.Column="1" 
                     local:EmailVerify.Activation="True" Text="me780411@gmail.com"
                     WidthRequest="250"/>
            <Entry x:Name="entry2" Grid.Row="2" Grid.Column="1" 
                   local:EmailVerify.Activation="True"   
                   WidthRequest="250"  Text="me780411@"  />
        </Grid>
    </StackLayout>

</ContentPage>